# ضع Bot Token الخاص بالبوت هنا (من Discord Developer Portal)
DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# (اختياري) لو حابب تربط الأوامر بسيرفر واحد فقط عشان تظهر فوراً بدون انتظار (بدلاً من المزامنة العالمية اللي بتاخد لحد ساعة)
GUILD_ID=

# توكن Cohere عشان يشتغل أمر /ai و /gf optimize (اختياري - لو سيبته فاضي هيرد البوت برسالة توضيحية بدل الكراش)
COHERE_API_KEY=

# (اختياري) آي دي قناة الألعاب - لو حطيته، أمر /play هيشتغل بس في القناة دي. سيبه فاضي عشان يشتغل في أي قناة.
GAME_CHANNEL_ID=

# (اختياري) اللينك الافتراضي اللي هيفتحه زرار "📲 افتح التطبيق" في /rally set و/shield - حط لينك المتجر أو رابط اللعبة بتاعك.
# لو سيبته فاضي هيستخدم الموقع الرسمي كافتراضي. كل سيرفر يقدر كمان يغيّره لنفسه بأمر /set_game_link (إدارة) من غير ما يلمس الـ .env.
GAME_APP_LINK=https://www.lordsmobile.com/
